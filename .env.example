APP_NAME="G-Analise IA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088
APP_PORT=8088
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
LOCAL_UID=1000
LOCAL_GID=1000
LOCAL_PREVIEW=false
ALLOW_REGISTRATION=false
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=horus_ia
DB_USERNAME=horus
DB_PASSWORD=horus_local_development
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=1200
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=horus-ia
REVERB_APP_KEY=horus-ia-reverb
REVERB_APP_SECRET=replace-with-random-secret
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8087
VITE_REVERB_SCHEME=http
OPENAI_SIGN_IN_ENABLED=false
OPENAI_AUTH_MODE=hosted
OPENAI_CLIENT_ID=
OPENAI_CLIENT_SECRET=
OPENAI_CLIENT_AUTH=none
OPENAI_REDIRECT_URI=http://localhost:8088/auth/openai/callback
OPENAI_SCOPES="openid profile email"
OPENAI_PLAN_USAGE_ENABLED=false
OPENAI_INFERENCE_SCOPE=
OPENAI_LOCAL_REDIRECT_URI=http://127.0.0.1:8088/auth/openai/callback
CODEX_BINARY=/usr/local/bin/codex
CODEX_DEFAULT_MODEL=
CODEX_TURN_TIMEOUT=900
LUMO_BINARY=/usr/local/bin/lumo
LUMO_API_URL=https://api.horusbi.com.br/cli/v2
LUMO_LOGIN_ENABLED=false

BI_READ_ONLY_TENANT_IDS=

AUDIT_RETENTION_DAYS=180
EXPORT_RETENTION_DAYS=30
LOG_DAILY_DAYS=14
MINIMUM_FREE_BYTES=104857600

# Visualizador nativo: habilitar somente após homologar o domínio e o isolamento.
BI_VIEWER_ENABLED=false
BI_VIEWER_ALLOWED_ORIGINS=https://g-analise.com.br

# Login de colaboradores pela API da Suíte Inovadora
SUITE_AUTH_ENABLED=true
SUITE_BASE_URL=https://suite.inovadora.com.br
SUITE_APPLICATION_CODE=g-analise-ia
SUITE_APPLICATION_NAME="G-Analise IA"

# MCP individual: uma autorização OAuth de leitura por usuário e ambiente.
BI_MCP_ENABLED=false
BI_MCP_RESOURCE=https://g-analise.com.br/mcp
BI_MCP_REDIRECT_URI="${APP_URL}/auth/bi-mcp/callback"
BI_MCP_CLIENT_ID=
