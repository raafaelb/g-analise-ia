APP_NAME="G-Analise IA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://suite.inovadora.com.br/ia-ganalise
ASSET_URL=https://suite.inovadora.com.br/ia-ganalise
PUBLIC_HOST=suite.inovadora.com.br
PUBLIC_PATH=/ia-ganalise
APP_PORT=8089
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
LOCAL_PREVIEW=false
ALLOW_REGISTRATION=false
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_DATABASE=horus_ia
DB_USERNAME=horus
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/ia-ganalise
SESSION_COOKIE=ganalise_ia_session
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=1200
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=g-analise-ia
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_ALLOWED_ORIGINS=suite.inovadora.com.br
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
OPENAI_SIGN_IN_ENABLED=false
OPENAI_AUTH_MODE=hosted
OPENAI_CLIENT_ID=
OPENAI_CLIENT_SECRET=
OPENAI_CLIENT_AUTH=none
OPENAI_REDIRECT_URI=https://suite.inovadora.com.br/ia-ganalise/auth/openai/callback
OPENAI_SCOPES="openid profile email"
OPENAI_PLAN_USAGE_ENABLED=false
OPENAI_INFERENCE_SCOPE=
CODEX_BINARY=/usr/local/bin/codex
CODEX_DEFAULT_MODEL=
CODEX_TURN_TIMEOUT=900
LUMO_BINARY=/usr/local/bin/lumo
LUMO_API_URL=https://api.horusbi.com.br/cli/v2
LUMO_WEB_URL=https://g-analise.com.br
LUMO_LOGIN_ENABLED=true
BI_READ_ONLY_TENANT_IDS=
AUDIT_RETENTION_DAYS=180
EXPORT_RETENTION_DAYS=30
MINIMUM_FREE_BYTES=104857600

# Visualizador nativo: habilitar somente após homologar o domínio e o isolamento.
BI_VIEWER_ENABLED=false
BI_VIEWER_ALLOWED_ORIGINS=https://g-analise.com.br

# Login de colaboradores pela API da Suíte Inovadora
SUITE_AUTH_ENABLED=true
SUITE_BASE_URL=https://suite.inovadora.com.br
SUITE_APPLICATION_CODE=g-analise-ia
SUITE_APPLICATION_NAME="G-Analise IA"
